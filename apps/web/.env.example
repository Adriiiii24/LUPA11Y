# Copia este fichero a .env.local. Ninguna variable es obligatoria.

# Activa la fase de visión (Gemini). Sin ella, el informe marca la visión como omitida.
GEMINI_API_KEY=

# Modelo de visión. Por defecto: gemini-3.8-flash
LUPA11Y_VISION_MODEL=

# Plan gratuito de Google AI Studio: la cuota es por modelo (unas 20 consultas al día y pocas por
# minuto) y cada auditoría hace hasta 14. El motor espera lo que pide Google ante el límite por
# minuto y reintenta si el modelo está saturado (503). Estas variables lo ajustan:
# Modelo de reserva si el principal agota su cuota diaria, no existe o sigue saturado.
LUPA11Y_VISION_FALLBACK_MODEL=
# Consultas por minuto como máximo (por ejemplo 5): evita chocar con el límite en vez de esperarlo.
LUPA11Y_VISION_RPM=
# Consultas por auditoría (14).
LUPA11Y_VISION_MAX_CALLS=

# Política de red de la API: public-only (defecto en producción) o any (defecto en desarrollo).
# En public-only, Chromium sale a Internet por un proxy que valida cada conexión (sin DNS rebinding).
LUPA11Y_NETWORK=

# Origen público del sitio: base de los metadatos, el sitemap, la tarjeta al compartir y la muestra.
LUPA11Y_SITE_URL=

# --- Cuota de la API ---------------------------------------------------------------------------
# Cabecera con la IP real del cliente que pone tu proxy de confianza (x-real-ip, cf-connecting-ip,
# fly-client-ip…). En Vercel se usa x-real-ip sin configurar nada. Si no declaras ninguna, nadie
# puede falsear su IP: todas las peticiones comparten una sola cuota.
LUPA11Y_CLIENT_IP_HEADER=
# O bien: cuántos proxies de confianza hay delante (se toma la IP n-ésima por el final de x-forwarded-for).
LUPA11Y_TRUSTED_PROXIES=
# Auditorías por cliente cada 10 min (6), por proceso cada 10 min (60) y a la vez (2).
LUPA11Y_QUOTA_PER_CLIENT=
LUPA11Y_QUOTA_GLOBAL=
LUPA11Y_MAX_CONCURRENT=

# --- Enlaces permanentes (/r/<id>) -------------------------------------------------------------
# Directorio donde se guardan los informes que produce la API. Vacío: desactivado.
LUPA11Y_REPORTS_DIR=
# Días que se conserva cada informe (7).
LUPA11Y_REPORTS_TTL_DAYS=
